# ============================================================
# application-local.properties.example
# 复制此文件为 application-local.properties 并填写真实值
# 该文件 (application-local.properties) 已被 .gitignore 排除
# ============================================================

# MySQL 连接
spring.datasource.url=jdbc:mysql://localhost:3306/official_website?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=root
spring.datasource.password=YOUR_MYSQL_PASSWORD_HERE

# 管理员账号
app.security.admin-username=administrator
app.security.admin-password=YOUR_STRONG_ADMIN_PASSWORD_HERE

# 生产环境建议关闭自动建表（手动执行 schema.sql）
spring.sql.init.mode=never
